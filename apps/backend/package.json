{
  "name": "@dtc/backend",
  "version": "0.0.2",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "medusa lint",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "seed:categories": "medusa exec ./src/scripts/seed-store-categories.ts",
    "backfill:print-categories": "medusa exec ./src/scripts/backfill-print-album-categories.ts"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.22.6",
    "@medusajs/admin-shared": "2.22.6",
    "@medusajs/caching": "2.22.6",
    "@medusajs/cli": "2.22.6",
    "@medusajs/dashboard": "2.22.6",
    "@medusajs/draft-order": "2.22.6",
    "@medusajs/framework": "2.22.6",
    "@medusajs/icons": "2.22.6",
    "@medusajs/js-sdk": "2.22.6",
    "@medusajs/medusa": "2.22.6",
    "@medusajs/ui": "4.2.13",
    "@react-email/components": "^1.0.12",
    "@tanstack/react-query": "5.64.2",
    "adm-zip": "^0.5.18",
    "react-i18next": "13.5.0",
    "react-router": "7.18.2",
    "react-router-dom": "7.18.2",
    "resend": "^6.17.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.22.6",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.36",
    "@types/adm-zip": "^0.5.8",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.19.2",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
